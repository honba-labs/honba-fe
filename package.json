{
  "name": "honba-fe",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "codegen": "make -C ../honba schema client FRONTEND_TS_DIR=$(pwd)/src/core/types/generated FRONTEND_CLIENT_DIR=$(pwd)/src/core/api/generated"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.15"
  }
}
